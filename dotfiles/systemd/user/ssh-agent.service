# A per-user ssh-agent, so an encrypted key is unlocked once per login rather
# than once per push.
#
# A systemd user unit rather than an `eval $(ssh-agent)` line in .zshrc: that
# form starts a NEW agent for every shell, each with its own socket and its own
# copy of the passphrase prompt, and leaves them all running after the shell
# exits. One unit means one agent per login session, and every shell finds it
# at the same fixed socket path.
#
# The socket lives in %t (XDG_RUNTIME_DIR, /run/user/UID): a tmpfs that systemd
# removes when the last session for the user ends, so the socket never outlives
# the login it belongs to.

[Unit]
Description=SSH key agent
Documentation=man:ssh-agent(1)

[Service]
Type=simple
Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
ExecStart=/usr/bin/ssh-agent -D -a $SSH_AUTH_SOCK
Restart=on-failure

[Install]
WantedBy=default.target
