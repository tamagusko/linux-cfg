[Unit]
Description=Academic dashboard (local, read-only)
Documentation=file:%h/repos/linux-cfg/dotfiles/dashboard/serve.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/repos/linux-cfg/dotfiles/dashboard/serve.py
Restart=on-failure
RestartSec=5
# Binds 127.0.0.1 only; nothing is written and nothing leaves the machine.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
