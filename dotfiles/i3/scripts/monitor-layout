#!/usr/bin/env bash
#
# Physical monitor arrangement — where each screen sits in the X coordinate
# space, which is what decides where the pointer crosses between them.
#
#          ┌──────────────┐
#          │     DP-1     │   Dell P2014H, 1600x900, main
#          └──────────────┘
#          ┌────────────────┐
#          │     HDMI-0     │   MSI MP161 E2, 1920x1080, below the main screen
#          └────────────────┘
#
# Pointer behaviour this produces:
#   main -> down   crosses to the small screen
#
# Two monitors since 2026-09-07, when the big central monitor (DP-5) died. The
# Dell that used to be the rotated portrait screen on DP-2 now stands in as
# the landscape main. The three-monitor version of this file is kept in
# ../layouts/three-monitors/ for when a replacement arrives.
#
# This is separate from the workspace assignment in ~/.config/i3/config. That
# decides which workspace *appears* on which output; this decides where the
# outputs *are*. Both are needed.
#
# Run by i3 via exec_always, so it re-applies on every reload
# ($mod+Shift+c) and after a cable change.

set -euo pipefail
IFS=$'\n\t'

MAIN=DP-1      # Dell, landscape, on top
SMALL=HDMI-0   # MSI, below the main one

# --below positions relatively, so no resolution is hardcoded here and the
# layout survives a monitor being swapped for a different size. The two
# screens are left-aligned; the MSI is 320 px wider than the Dell, so its
# right edge sticks out with nothing above it.

connected() {
    xrandr --query | awk -v o="$1" '$1 == o && $2 == "connected" { found = 1 } END { exit !found }'
}

command -v xrandr >/dev/null 2>&1 || exit 0

if ! connected "$MAIN"; then
    echo "monitor-layout: $MAIN not connected, leaving the layout alone" >&2
    exit 0
fi

args=(--output "$MAIN" --auto --primary --rotate normal)

if connected "$SMALL"; then
    args+=(--output "$SMALL" --auto --rotate normal --below "$MAIN")
else
    args+=(--output "$SMALL" --off)
fi

xrandr "${args[@]}"
