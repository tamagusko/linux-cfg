<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS equivalent of the systemd user unit: starts the server at login.
     Install with: cp to ~/Library/LaunchAgents/ then `launchctl load` it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tamagusko.academic-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>REPLACE_WITH_HOME/repos/linux-cfg/dotfiles/dashboard/serve.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
