# Managed by linux-cfg (stages/70-dotfiles.sh). Replaced on re-run.
# Machine-specific additions live in the marked linux-cfg blocks at the bottom
# and are preserved across replacement — put your own edits there, or in
# ~/.zshrc.local, which is sourced at the end and never touched.

# Powerlevel10k instant prompt. Must stay near the top; anything that needs
# console input has to go above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins. zsh-syntax-highlighting and zsh-autosuggestions are cloned into
# $ZSH_CUSTOM/plugins by stage 70 — not into $ZSH/plugins, which oh-my-zsh owns
# and overwrites on self-update.
plugins=(
  git
  sudo
  gitfast
  command-not-found
  gitignore
  fzf
  colored-man-pages
  docker
  zsh-syntax-highlighting
  zsh-autosuggestions
)

source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------------ environment

# ~/.local/bin is not on Arch's default PATH, but it is where the Claude Code
# native installer puts its `claude` symlink and where `uv tool install` puts
# entry points. Set here, above the `command -v` probes below, so tools living
# there are visible to them.
#
# Guarded against re-entry: this file is sourced again by every `source ~/.zshrc`
# and by nested interactive shells, and an unguarded prepend duplicates the entry
# each time — as the linux-cfg:cuda block below demonstrates.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'

# ---------------------------------------------------------------------- aliases

alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias svi='sudo vim'

# eza / bat / fd replace ls / cat / find where installed.
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lh --group-directories-first --git'
  alias la='eza -lha --group-directories-first --git'
  alias lt='eza --tree --level=2'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'

# Python: uv only. No `alias python=python3` and no pinned 3.9 aliases — the
# system interpreter is externally managed (PEP 668) and uv owns per-project
# environments.
alias uvr='uv run'
alias uvs='uv sync'
alias uva='uv add'

alias gitignorebig='find . -size +100M >> .gitignore'

# ------------------------------------------------------------------- pacman/paru
alias update='sudo pacman -Syu'
alias updateall='paru -Syu'
alias orphans='pacman -Qtdq'
alias cleancache='paccache -r'

# --------------------------------------------------------------------- keyboard
# Caps Lock as Escape, X11 only. Guarded on $DISPLAY: unguarded, this errored on
# every TTY and SSH login, and it was also duplicated.
if [[ -n "$DISPLAY" ]] && command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap -option 'caps:escape' 2>/dev/null || true
fi

# ------------------------------------------------------------------------ tools
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ssh-agent: gcr-ssh-agent, from gcr-4, enabled as a user socket by stage 80.
#
# Chosen over a plain ssh-agent because it is backed by the login keyring. A
# plain agent holds the decrypted key in RAM only, so every reboot costs a
# passphrase prompt; gcr stores the passphrase in the keyring, which
# pam_gnome_keyring unlocks with the password already typed at the lightdm
# prompt. The key stays encrypted on disk either way — a stolen drive is still
# useless without the login password — but there is nothing left to type.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/gcr/ssh"

# gcr's own askpass, not x11-ssh-askpass: its dialog carries the "remember"
# option that writes the passphrase into the keyring. The plain X11 dialog
# unlocks the key for one session and forgets it.
export SSH_ASKPASS=/usr/lib/gcr4-ssh-askpass
export SSH_ASKPASS_REQUIRE=prefer

# Personal overrides, never managed by linux-cfg.
[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
