# paper.mplstyle: matplotlib defaults for journal figures.
# Usage: plt.style.use('path/to/paper.mplstyle')
# Serif by default because Elsevier (elsarticle) and IEEE Transactions set body text
# in a Times-like face; figure text should match the body font. For a sans-serif
# venue (Springer, some Wiley) switch the two font lines marked SANS below.
# On a stock Linux box Times New Roman is absent and matplotlib falls back along the
# list to Liberation Serif (metric-compatible with Times) or STIXGeneral; both embed
# cleanly. Check the resolved face with scripts/text_size_check.py.
# Adjust figure.figsize per figure: 3.54 in = 90 mm single column,
# 5.51 in = 140 mm 1.5 column, 7.48 in = 190 mm double column.

# Geometry
figure.figsize      : 3.54, 2.36
figure.dpi          : 150
savefig.dpi         : 600
savefig.bbox        : tight
savefig.pad_inches  : 0.02
savefig.format      : pdf
pdf.fonttype        : 42
ps.fonttype         : 42
svg.fonttype        : none

# Typography (8 pt labels, 7 pt ticks; matches 9 to 10 pt body text)
font.family         : serif
font.serif          : Times New Roman, Times, Nimbus Roman, TeX Gyre Termes, Liberation Serif, STIXGeneral, DejaVu Serif
mathtext.fontset    : stix
# SANS: replace the two lines above with
# font.family       : sans-serif
# font.sans-serif   : Helvetica, Arial, Liberation Sans, DejaVu Sans
# mathtext.fontset  : dejavusans
font.size           : 8
axes.titlesize      : 8
axes.labelsize      : 8
xtick.labelsize     : 7
ytick.labelsize     : 7
legend.fontsize     : 7
legend.title_fontsize : 7

# Axes and spines
axes.linewidth      : 0.6
axes.spines.top     : False
axes.spines.right   : False
axes.grid           : False
axes.axisbelow      : True
axes.labelpad       : 3
axes.xmargin        : 0.03
axes.ymargin        : 0.05
axes.formatter.use_mathtext : True
axes.formatter.limits : -3, 4

# Ticks
xtick.direction     : out
ytick.direction     : out
xtick.major.width   : 0.6
ytick.major.width   : 0.6
xtick.major.size    : 3
ytick.major.size    : 3
xtick.minor.visible : False
ytick.minor.visible : False

# Lines and markers (0.5 pt minimum at print size; 1.0 pt for data lines)
lines.linewidth     : 1.0
lines.markersize    : 3.5
lines.markeredgewidth : 0.6
errorbar.capsize    : 2
patch.linewidth     : 0.6
hatch.linewidth     : 0.5

# Legend (prefer direct labels; if a legend is unavoidable keep it quiet)
legend.frameon      : False
legend.handlelength : 1.5
legend.borderaxespad: 0.3
legend.columnspacing: 1.0

# Colour cycle: Okabe-Ito, colour-blind safe; paired with line styles so the
# series stay distinguishable in greyscale. Same order in every figure of the paper.
axes.prop_cycle     : cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', 'CC79A7', '56B4E9']) + cycler('linestyle', ['-', '--', '-.', ':', '-', '--'])

# Colour maps: sequential viridis; use 'RdBu_r' or 'PuOr' for diverging data
image.cmap          : viridis
