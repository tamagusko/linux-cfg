# macOS / editor noise
.DS_Store
*.swp
*~

# Install artefacts, produced on the target machine and never committed
*.log
*.linux-cfg-bak.*

# Local overrides
.zshrc.local

# NOTE: do NOT add a bare `lib/` rule here. This repo keeps its shared shell
# helpers in lib/common.sh, which every stage sources. A `lib/` rule (inherited
# from a Python .gitignore template) previously excluded it from every commit,
# so a fresh clone had no lib/ directory and install.sh died at its source line.
